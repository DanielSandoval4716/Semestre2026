<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Princi.App"
             RequestedThemeVariant="Default">
<Application.Resources>
        <Color x:Key="ColorPrimario">#E74C3C</Color>
        <Color x:Key="ColorSecundario">#3498DB</Color>
        <Color x:Key="ColorFondo">#F5F6FA</Color>
        <Color x:Key="ColorTexto">#2C3E50</Color>
        <Color x:Key="ColorExito">#2ECC71</Color>
        <Color x:Key="ColorError">#E74C3C</Color>

        <SolidColorBrush x:Key="BrushPrimario"    Color="{StaticResource ColorPrimario}"/>
        <SolidColorBrush x:Key="BrushSecundario"  Color="{StaticResource ColorSecundario}"/>
        <SolidColorBrush x:Key="BrushFondo"       Color="{StaticResource ColorFondo}"/>
        <SolidColorBrush x:Key="BrushTexto"       Color="{StaticResource ColorTexto}"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
<Setter Property="Background"   Value="#E74C3C"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Transitions">
        <Transitions>
            <!-- suaviza el cambio de Background en 200ms -->
            <BrushTransition Property="Background" Duration="0:0:0.2"/>
        </Transitions>
    </Setter>
        </Style>
<Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C0392B"/>
</Style>
<Style Selector="TextBox">
    <Setter Property="BorderBrush"     Value="#DDE1E7"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius"    Value="8"/>
    <Setter Property="Transitions">
        <Transitions>
            <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
        </Transitions>
    </Setter>
</Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#3498DB"/>
        </Style>
        <!-- TextBlock títulos -->
        <Style Selector="TextBlock.titulo">
            <Setter Property="FontSize"   Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        </Style>
        <!-- RadioButton -->
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="FontSize"   Value="14"/>
        </Style>
    </Application.Styles>
</Application>
